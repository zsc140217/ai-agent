{
  "pre:commit:*": [
    {
      "name": "secret-scan",
      "command": "bash scripts/secret-scan.sh",
      "description": "扫描敏感信息泄露"
    },
    {
      "name": "run-tests",
      "command": "./mvnw test -Dtest=RAGEvaluationTest",
      "description": "运行RAG评估测试",
      "timeout": 60000
    }
  ],
  "post:commit:*": [
    {
      "name": "commit-success",
      "command": "echo '✅ 提交成功，测试通过'",
      "description": "提交成功提示"
    }
  ],
  "pre:bash:*": [
    {
      "name": "bash-audit",
      "command": "echo '🔍 执行Bash命令: $BASH_COMMAND'",
      "description": "Bash命令审计日志"
    }
  ]
}
